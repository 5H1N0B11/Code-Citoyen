# --- Mode LLM ---
# "cloud" (défaut) : utilise Mistral + Groq (cloud)
# "local"          : utilise Ollama (LLM local) — voir variables OLLAMA_* plus bas
LLM_MODE=cloud

# --- Clés API (requises uniquement en mode cloud) ---
MISTRAL_API_KEY=your_mistral_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Configuration Ollama (mode local) ---
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=mistral-nemo:12b
# OLLAMA_NUM_CTX=16384       # taille du contexte (défaut Ollama = 4096, trop court pour nos prompts)
# OLLAMA_TIMEOUT=180         # timeout (s) pour un appel chat

# --- Configuration ASR & diarisation (ingestion par audio) ---
# WHISPER_MODEL=large-v3-turbo     # modèle faster-whisper
# WHISPER_DEVICE=cuda              # "cpu" si VRAM saturée par le LLM
# WHISPER_COMPUTE_TYPE=float16     # "int8" pour le CPU
# WHISPER_LANGUAGE=fr
# DIARIZATION_DEVICE=cpu           # Resemblyzer (modèle léger, CPU OK)
# DIARIZATION_THRESHOLD=0.30       # seuil cosinus de clustering speaker

# Proxy YouTube (optionnel — utile si YouTube bloque les requêtes directes)
# YOUTUBE_PROXY=http://user:password@host:port

# Mode debug Flask (0 = désactivé, 1 = activé — NE JAMAIS mettre 1 en production)
FLASK_DEBUG=0
